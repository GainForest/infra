# Keep the real .env private: chmod 600 .env

# Source: the R2 bucket the GainForest app uploads AudioMoth originals to.
# Same values as the app's DATA_JOBS_S3_* variables. The runner only reads from
# it, so a read-only token (list + get) is enough.
DATA_JOBS_S3_ENDPOINT=
DATA_JOBS_S3_BUCKET=
DATA_JOBS_S3_ACCESS_KEY_ID=
DATA_JOBS_S3_SECRET_ACCESS_KEY=
DATA_JOBS_S3_REGION=auto

# Destination: the shared archive bucket. Same values as the app's ARCHIVE_S3_*
# variables, which it reads in getArchiveS3Config() (app/_lib/s3-storage.ts).
# On AWS S3 the region is required, e.g. ARCHIVE_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# with ARCHIVE_S3_REGION=eu-west-3. The runner refuses to start if an
# amazonaws.com endpoint has an empty or "auto" region, because AWS signs
# requests per region and would reject every one.
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
ARCHIVE_S3_REGION=

# Optional
# INDEXER_URL=https://api-hi.gainforest.app/graphql
# PDS hosts the runner may read ac.audio records from (comma-separated, exact hostnames).
# AUDIO_ARCHIVE_PDS_HOSTS=certified.one
# Leave files younger than this for a later run (the app writes the ac.audio record after the upload).
# AUDIO_ARCHIVE_MIN_AGE_MINUTES=30
# Cap on transfer speed, in megabits per second. Unset means unlimited.
# AUDIO_ARCHIVE_MAX_MBPS=50
# Loopback TCP port held while a run is in progress, so two runs never overlap.
# AUDIO_ARCHIVE_LOCK_PORT=29437
# Only if the first copy from R2 fails over x-amz-checksum-mode; see README, Troubleshooting.
# SOURCE_S3_CHECKSUM_MODE=when_required
